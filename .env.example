# Copy this file to .env, fill in ACCESS_TOKEN and ORG_NAME, then size the pool
# for this machine:
#   cp .env.example .env
#   scripts/sizing.sh --write
# .env is gitignored. Never commit it and never print its ACCESS_TOKEN line.

# GitHub personal access token the runners register with:
# - One checkout that switches between orgs (`/start <org>`): classic PAT with
#   the admin:org scope, from an account that owns every org it switches to.
# - One org only (e.g. a dedicated server): fine-grained PAT whose resource
#   owner is that org, with the organization permission
#   "Self-hosted runners: read & write".
ACCESS_TOKEN=your_personal_access_token

# GitHub org the runner pool registers to (any org your token can manage).
# On a workstation, switch with `/start <org>` (rewrites this line and
# recreates the runners). On a dedicated server, set it once and leave it.
ORG_NAME=your-org

# Optional: labels added on top of the ones the runner adds itself
# (self-hosted, Linux, and X64 or ARM64 for this machine's architecture).
# RUNNER_LABELS=self-hosted,linux,docker,test

# Machine capacity: RUNNERS, RUNNER_CPUS and RUNNER_MEMORY. Don't pick them by
# hand — `scripts/sizing.sh --write` computes them from the CPUs and memory
# Docker can use and writes them below (see "Sizing" in README.md), e.g.:
#   12 CPUs, 16 GB -> RUNNERS=3  RUNNER_CPUS=3  RUNNER_MEMORY=3G
#    1 CPU,   4 GB -> RUNNERS=1  RUNNER_CPUS=1  RUNNER_MEMORY=3G
# Until they are set, docker-compose.yml runs 1 runner with 1 CPU and 2G.
